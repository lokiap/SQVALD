{% extends "base.html.twig" %}

{% block title %}SQVALD | Partenaires{% endblock %}

{% block style %}
	<style>
		.partner-logo {
			height: 180px;
			display: grid;
			place-items: center;
			padding: 1.75rem;
			border-bottom: 1px solid var(--sq-border);
		}

		.partner-logo img {
			max-height: 124px;
			max-width: 100%;
			object-fit: contain;
		}

		.partner-card .card-body {
			display: flex;
			flex-direction: column;
			gap: 1.25rem;
			padding: 1.5rem;
		}

		.partner-card .card-body p {
			color: var(--sq-ink);
			font-weight: 500;
			margin: 0;
			flex-grow: 1;
		}

		.partner-actions {
			display: flex;
			justify-content: space-between;
			align-items: center;
			gap: .5rem;
		}

		.partner-actions a {
			font-weight: 600;
			font-size: .9rem;
			text-decoration: none;
		}

		.partner-actions .btn-outline {
			border: 1px solid var(--sq-border);
			border-radius: 999px;
			padding: .45rem 1rem;
			color: var(--sq-text);
		}

		.partner-actions .btn-outline:hover {
			border-color: var(--sq-primary);
			color: var(--sq-primary);
		}
	</style>
{% endblock %}

{% block body %}
	<main class="container pb-5">
		<h1 class="page-title">Nos partenaires</h1>
		<p class="sq-section-sub">Les organisations membres du consortium SQVALD.</p>
		<div class="row g-4">
			{% for partner in partners %}
				<div class="col-md-6 col-lg-4">
					<div class="card h-100 partner-card">
						<div class="partner-logo">
							<img src="{{ vich_uploader_asset(partner, 'illustrationFile') }}" alt="{{ partner.content }}">
						</div>
						<div class="card-body">
							<p>{{ partner.content }}</p>
							<div class="partner-actions">
								<a href="{{ partner.btnUrl }}">Site web <i class="fas fa-external-link-alt"></i></a>
								<a class="btn-outline" href="{{ path('show_membre', {'partner' : partner.id}) }}">Membres associés</a>
							</div>
						</div>
					</div>
				</div>
			{% endfor %}
		</div>
	</main>
{% endblock %}
