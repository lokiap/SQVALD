{% extends 'base.html.twig' %}

{% block title %}SQVALD | Accueil{% endblock %}

{% block body %}
	<main>
		<section class="sq-hero">
			<div class="container">
				<div class="row align-items-center g-5">
				<div class="col-lg-7">
				<span class="sq-eyebrow">Projet de recherche · RTR DIAMS · Centre-Val de Loire</span>
				<h1>Mieux orienter et accompagner les patients en soins de support</h1>
				<p class="lead mt-3 mb-4">SQVALD réunit chercheurs, soignants et associations pour recommander des activités adaptées aux patients atteints de maladies chroniques, et suivre leur qualité de vie au quotidien.</p>
				<div class="d-flex flex-wrap gap-3">
					<a class="sq-btn sq-btn-light" href="{{ path('a_propos') }}">Découvrir le projet <i class="fas fa-arrow-right"></i></a>
					<a class="sq-btn sq-btn-ghost" href="{{ path('news_index') }}">Voir les actualités</a>
				</div>
				<div class="sq-hero-stats">
					<div><strong>{{ partners|length }}</strong><span>partenaires</span></div>
					<div><strong>3</strong><span>axes de recherche</span></div>
					<div><strong>36</strong><span>mois de projet</span></div>
				</div>
				</div>
				<div class="col-lg-5 d-none d-lg-block">
					<div class="sq-hero-visual">
						<div class="sq-glass"><span class="sq-glass-icon"><i class="fas fa-search-location"></i></span><div><strong>Recommander</strong><span>Activités adaptées au profil du patient</span></div></div>
						<div class="sq-glass"><span class="sq-glass-icon"><i class="fas fa-hands-helping"></i></span><div><strong>Accompagner</strong><span>Organisation et logistique des soins</span></div></div>
						<div class="sq-glass"><span class="sq-glass-icon"><i class="fas fa-chart-line"></i></span><div><strong>Suivre</strong><span>Qualité de vie mesurée par objets connectés</span></div></div>
					</div>
				</div>
				</div>
			</div>
		</section>

		<section class="sq-section">
			<div class="container">
				<h2 class="sq-section-title">Objectifs du projet</h2>
				<p class="sq-section-sub">Trois axes pour rendre l'offre de soins de support plus lisible et le parcours du patient plus simple.</p>
				<div class="row g-4">
					<div class="col-md-4">
						<div class="sq-feature">
							<div class="sq-feature-icon"><i class="fas fa-map-marked-alt"></i></div>
							<h3>Une vue globale de l'offre</h3>
							<ul>
								<li>Coordination de l'existant (ROR, sport-santé, e-santé)</li>
								<li>Ouverture vers les patients et les aidants</li>
							</ul>
						</div>
					</div>
					<div class="col-md-4">
						<div class="sq-feature">
							<div class="sq-feature-icon"><i class="fas fa-route"></i></div>
							<h3>Recommander et organiser</h3>
							<ul>
								<li>Adhésion du patient</li>
								<li>Planification et logistique</li>
								<li>Suivi et accompagnement</li>
							</ul>
						</div>
					</div>
					<div class="col-md-4">
						<div class="sq-feature">
							<div class="sq-feature-icon"><i class="fas fa-heartbeat"></i></div>
							<h3>Observer et analyser</h3>
							<ul>
								<li>Suivi au fur et à mesure et a posteriori</li>
								<li>Impact sur la qualité de vie</li>
								<li>Autonomie du patient</li>
							</ul>
						</div>
					</div>
				</div>
			</div>
		</section>

		{% if news is not empty or documents is not empty or events is not empty %}
			<section class="sq-section pt-0">
				<div class="container">
					<div class="d-flex justify-content-between align-items-end mb-4">
						<div>
							<h2 class="sq-section-title">À la une</h2>
							<p class="sq-section-sub mb-0">Les dernières publications du consortium.</p>
						</div>
						<a href="{{ path('news_index') }}" class="fw-semibold text-decoration-none">Toutes les actualités <i class="fas fa-arrow-right"></i></a>
					</div>
					<div class="row g-4">
						{% for event in events %}
							<div class="col-md-6 col-lg-4">
								<a class="sq-latest" href="{{ path('showEvent', {'slug': event.slug}) }}">
									<span class="sq-badge sq-badge-event">Évènement</span>
									<span class="sq-date">{{ event.dateBegin|format_datetime(locale='fr', pattern='d MMM y') }}</span>
									<h3>{{ event.title }}</h3>
									<p>{{ event.resume }}</p>
								</a>
							</div>
						{% endfor %}
						{% for item in news %}
							<div class="col-md-6 col-lg-4">
								<a class="sq-latest" href="{{ path('news_show', {'slug': item.slug}) }}">
									<span class="sq-badge">Actualité</span>
									<span class="sq-date">{{ item.createdAt|format_datetime(locale='fr', pattern='d MMM y') }}</span>
									<h3>{{ item.title }}</h3>
									<p>{{ item.resume }}</p>
								</a>
							</div>
						{% endfor %}
						{% for document in documents %}
							<div class="col-md-6 col-lg-4">
								<a class="sq-latest" href="{{ path('showDocument', {'slug': document.slug}) }}">
									<span class="sq-badge sq-badge-doc">{{ document.categorydonnees ? document.categorydonnees.name : 'Document' }}</span>
									<span class="sq-date">{{ document.createdAt|format_datetime(locale='fr', pattern='d MMM y') }}</span>
									<h3>{{ document.title }}</h3>
									<p>{{ document.resume }}</p>
								</a>
							</div>
						{% endfor %}
					</div>
				</div>
			</section>
		{% endif %}

		{% if partners is not empty %}
			<section class="sq-section sq-partners">
				<div class="container">
					<h2 class="sq-section-title text-center">Le consortium</h2>
					<p class="sq-section-sub text-center mx-auto">Laboratoires, établissements de santé, associations et collectivités.</p>
					<div class="row g-3 align-items-center">
						{% for partner in partners %}
							<div class="col-6 col-md-3">
								<a class="sq-partner-logo" href="{{ partner.btnUrl }}" title="{{ partner.content }}">
									<img src="{{ vich_uploader_asset(partner, 'illustrationFile') }}" alt="{{ partner.content }}">
								</a>
							</div>
						{% endfor %}
					</div>
					<div class="text-center mt-4">
						<a href="{{ path('partners_index') }}" class="fw-semibold text-decoration-none">Voir tous les partenaires <i class="fas fa-arrow-right"></i></a>
					</div>
				</div>
			</section>
		{% endif %}
	</main>
{% endblock %}
